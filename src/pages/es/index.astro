---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-es');
---

<Layout title="Un Monde Saint-Barth — Estilo de Vida y Lujo en Saint-Barth en Español" lang="es">
  <section class="border-b border-stone-200 bg-[#faf8f5] py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-800/20 bg-amber-100/50 px-3.5 py-1 text-xs text-amber-900 font-semibold mb-4">
        EDICIÓN EN ESPAÑOL
      </div>
      <h1 class="font-serif-luxury text-3xl font-bold text-stone-900 sm:text-5xl">El Arte de Vivir en San Bartolomé</h1>
      <p class="mt-4 max-w-2xl text-stone-600 text-sm sm:text-base leading-relaxed font-light">
        Villas exclusivas sobre el mar Caribe, gastronomía refinada, playas vírgenes y privacidad incomparable.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="flex flex-col justify-between rounded-sm border border-stone-200 bg-[#faf8f5] p-6 hover:border-amber-800/50 transition-colors">
            <div>
              <span class="rounded bg-amber-100 px-2 py-0.5 text-[10px] text-amber-900 font-semibold uppercase">{post.data.category}</span>
              <h2 class="font-serif-luxury text-lg font-bold text-stone-900 mt-3 hover:text-amber-800 transition-colors">
                <a href={'/es/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-stone-600 leading-relaxed font-light">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-stone-200 text-xs">
              <a href={'/es/' + post.id + '/'} class="text-amber-800 hover:underline font-semibold uppercase text-[11px] tracking-wider">Leer Artículo →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
